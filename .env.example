# Create .env locally and fill in your NEW token and numeric Telegram user ID.
TELEGRAM_BOT_TOKEN=
AUTHORIZED_USER_ID=

# Default local Ollama endpoint and model. Pull the model before starting.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional tuning
CONTEXT_WINDOW=20
MAX_RESPONSE_TOKENS=900
MAX_CONVERSATIONS=300
SAVE_INTERVAL=5

# Local runtime files, excluded from version control
MEMORY_FILE=memory.json
OWNER_STATE_FILE=owner_state.json
LOG_FILE=mrrobot.log
